{
  "name": "rhythm-coach",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:local": "tsc --noEmit -p tsconfig.local.json",
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --format=esm --target=es2022 --outfile=dist/worker.js",
    "local:build": "tsc --noEmit -p tsconfig.local.json && esbuild local/server.ts --bundle --platform=node --format=esm --outfile=dist/local.js",
    "local": "npm run local:build && node dist/local.js"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@types/node": "^22.0.0"
  }
}
